AUTH_SECRET=
POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=
FARM_DATABASE_URL=

# Optional local-only mapping to a generated farm_access subject.
FARM_DEMO_SUBJECT_ID=

# Vercel AI Gateway: Ling 3.0 Flash Sante Free for chat and titles.
# The free endpoint stops after the promotion; no paid model fallback.
# Local authentication uses this key; Vercel deployments can use project OIDC.
AI_GATEWAY_API_KEY=

# OpenRouter Free for chat; titles are derived locally. Create a key at openrouter.ai/settings/keys.
# AI_RUNTIME=openrouter fails closed: it never falls back to Vercel or paid models.
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_API_KEY=
AI_MODEL_ID=openrouter/free
AI_MODEL_VISION=true

# Local development through an existing Codex CLI ChatGPT login.
# The login is cached outside the project in ~/.codex and survives app restarts.
AI_RUNTIME=openrouter
CODEX_CLI_PATH=codex
CODEX_MODEL=

# Process skills: explicitly enable only for the intended simulation farms.
# Comma-separated UUIDs from farm_access, never CSV company_id.
FARM_SKILL_PROFILE_ID=
FARM_SKILL_PROFILE_FARM_IDS=

# Server-side active farm restriction, intersected with user grants.
FARM_ACTIVE_ID=

# Seed private example chats on first visit to the assistant. Requires both databases.
DEMO_WELCOME_ENABLED=0

# Optional public demo: grant each visitor READER access to this one farm.
# Must equal FARM_ACTIVE_ID and the farm must have settings.publicDemo=true.
# Set only for the published synthetic farm, never for client/production data.
DEMO_PUBLIC_FARM_ID=
